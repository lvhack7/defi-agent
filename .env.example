ZOOWORK_API_KEY=
# Public WalletConnect project ID; secrets must never use the VITE_ prefix.
VITE_WALLETCONNECT_PROJECT_ID=
# Backend-only RPCs. Base's public endpoint is rate-limited; a dedicated provider can be substituted.
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
# CoinGecko Demo API key, backend-only.
COINGECKO_API_KEY=
# These remain off until the operator explicitly enables the corresponding chain.
ENABLE_BASE_MAINNET_EXECUTION=false
ENABLE_ETHEREUM_MAINNET_EXECUTION=false
# Backend policy limits; the agent cannot change them.
MAX_TRADE_USD=100
MAX_GAS_USD=5
